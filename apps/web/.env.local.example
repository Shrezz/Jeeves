# Copy to .env.local and use keys from the SAME Clerk development instance.
# Keep the secret key server-side; never prefix it with VITE_.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# The local launcher supplies the database URL, frontend key, and localhost ports.
# No OpenAI, Nebius, Replit storage, or production credentials are needed here.

# Local claim chat. Start Ollama and install this model (or choose another local model).
CLAIM_CHAT_PROVIDER=ollama
OLLAMA_MODEL=gemma4:12b

# Optional server-side Langfuse tracing. Never use VITE_ for secret keys.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional detailed tracing for explicitly listed fictional claims only.
# Never put real policyholder data in those claims; IDs alone are not anonymization.
LANGFUSE_CAPTURE_SYNTHETIC_CONTENT=false
JEEVES_SYNTHETIC_TRACE_CLAIM_IDS=

# Optional public searches; only the separate user-entered query is sent.
KEENABLE_SEARCH_ENABLED=false
KEENABLE_API_KEY=

# For Nebius on BOTH the dashboard and claim workflow, set CLAIM_CHAT_PROVIDER=nebius.
# Use two distinct chat model IDs from your Token Factory project; leave secrets out of Git.
NEBIUS_API_KEY=
NEBIUS_GENERATOR_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEBIUS_REVIEWER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
