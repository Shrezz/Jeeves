  "components": {
    "schemas": {
      "ActionResult": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "saved",
              "prepared"
            ],
            "title": "Outcome"
          },
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "title": "Claim Id"
          },
          "claim_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Claim Version"
          },
          "artifact_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "integrated"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "claim_id",
          "claim_version",
          "mode"
        ],
        "title": "ActionResult"
      },
      "Citation": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "policy_id": {
            "type": "string",
            "title": "Policy Id"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunk_id",
          "policy_id",
          "policy_version",
          "page",
          "section",
          "excerpt",
          "score"
        ],
        "title": "Citation"
      },
      "Clarification": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "claim_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Clarification"
      },
      "CoverageDraft": {
        "properties": {
          "conclusion": {
            "type": "string",
            "enum": [
              "likely_covered",
              "likely_not_covered",
              "unclear"
            ],
            "title": "Conclusion"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "title": "Explanation"
          },
          "citation_ids": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Citation Ids"
          },
          "missing_information": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Missing Information"
          },
          "covered_amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Covered Amount"
          },
          "deductible": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deductible"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conclusion",
          "explanation"
        ],
        "title": "CoverageDraft"
      },
      "EstimateRequest": {
        "properties": {
          "eligible_loss": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Eligible Loss"
          },
          "deductible": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Deductible"
          }
        },
        "type": "object",
        "required": [
          "eligible_loss",
          "deductible"
        ],
        "title": "EstimateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HumanDecision": {
        "properties": {
          "artifact_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Artifact Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Action"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_version",
          "action"
        ],
        "title": "HumanDecision"
      },
      "IncidentFacts": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "cause": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause"
          },
          "occurred_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred On"
          },
          "repair_cost": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repair Cost"
          },
          "repair_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "pending",
                  "scheduled",
                  "completed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Repair Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "IncidentFacts"
      },
      "PacketDraft": {
        "properties": {
          "narrative": {
            "type": "string",
            "minLength": 1,
            "title": "Narrative"
          },
          "facts": {
            "$ref": "#/components/schemas/IncidentFacts"
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageDraft"
          },
          "attachment_ids": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Attachment Ids"
          },
          "missing_information": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Missing Information"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "narrative",
          "facts",
          "coverage"
        ],
        "title": "PacketDraft"
      },
      "PaymentEstimate": {
        "properties": {
          "covered_amount": {
            "type": "string",
            "title": "Covered Amount"
          },
          "deductible": {
            "type": "string",
            "title": "Deductible"
          },
          "estimated_payment": {
            "type": "string",
            "title": "Estimated Payment"
          },
          "basis": {
            "type": "string",
            "title": "Basis",
            "default": "Simplified demo estimate: covered amount minus a flat deductible, minimum zero."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "covered_amount",
          "deductible",
          "estimated_payment"
        ],
        "title": "PaymentEstimate"
      },
      "PendingAction": {
        "properties": {
          "interrupt_id": {
            "type": "string",
            "title": "Interrupt Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "clarification",
              "human_review"
            ],
            "title": "Kind"
          },
          "route": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answer_claim",
                  "save_claim_status",
                  "file_claim"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Questions"
          },
          "artifact_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Version"
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StatusDraft"
              },
              {
                "$ref": "#/components/schemas/PacketDraft"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft"
          },
          "estimate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PaymentEstimate"
              },
              {
                "type": "null"
              }
            ]
          },
          "actions": {
            "items": {
              "type": "string",
              "enum": [
                "approve",
                "edit",
                "reject"
              ]
            },
            "type": "array",
            "title": "Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "interrupt_id",
          "kind"
        ],
        "title": "PendingAction"
      },
      "ResumeRun": {
        "properties": {
          "request_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Request Key"
          },
          "interrupt_id": {
            "type": "string",
            "minLength": 1,
            "title": "Interrupt Id"
          },
          "clarification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Clarification"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HumanDecision"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_key",
          "interrupt_id"
        ],
        "title": "ResumeRun"
      },
      "ReviewIssue": {
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "title": "Check"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "title": "Detail"
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "citation_ids": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Citation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "check",
          "detail"
        ],
        "title": "ReviewIssue"
      },
      "ReviewedAnswer": {
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageDraft"
          },
          "estimate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PaymentEstimate"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_actions": {
            "items": {
              "type": "string",
              "enum": [
                "save_resolution",
                "prepare_packet"
              ]
            },
            "type": "array",
            "title": "Next Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coverage"
        ],
        "title": "ReviewedAnswer"
      },
      "RouteRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Message"
          },
          "selected_claim_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Claim Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "RouteRequest"
      },
      "RouterResult": {
        "properties": {
          "intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answer_claim",
                  "file_claim",
                  "save_claim_status"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "claim_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Id"
          },
          "needs_clarification": {
            "type": "boolean",
            "title": "Needs Clarification"
          },
          "clarification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification"
          }
        },
        "type": "object",
        "required": [
          "intent",
          "claim_id",
          "needs_clarification"
        ],
        "title": "RouterResult"
      },
      "RunView": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "integrated"
            ],
            "title": "Mode"
          },
          "model_mode": {
            "type": "string",
            "enum": [
              "fixture",
              "nebius",
              "injected"
            ],
            "title": "Model Mode",
            "default": "injected"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "awaiting_information",
              "awaiting_review",
              "completed",
              "blocked",
              "rejected",
              "failed"
            ],
            "title": "Status"
          },
          "route": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answer_claim",
                  "save_claim_status",
                  "file_claim"
                ]
              },
              {
                "type": "null"
              }
            ],
