# Copy to .env for local Docker Compose use. Replace the local-only password.
POSTGRES_DB=claim_companion
POSTGRES_USER=claim_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Optional Langfuse tracing credentials. Never commit real credentials.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Explicit local demo. Fixtures, runs, approvals and exports live in memory and reset on restart.
JEEVES_MODE=demo
JEEVES_DEMO_TOKEN=replace-with-a-local-demo-token
MODEL_MODE=fixture
UI_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: MODEL_MODE=nebius uses real model credits with synthetic policy/claim adapters.
# Verify these IDs in your account before enabling. No automatic OpenAI fallback.
NEBIUS_API_KEY=
NEBIUS_GENERATOR_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEBIUS_REVIEWER_MODEL=Qwen/Qwen3.8-27B
